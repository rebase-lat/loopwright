{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "harness/.opencode/plugins",
    "oxlint.config.ts",
    "oxfmt.config.ts"
  ]
}
