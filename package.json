{
  "name": "loopwright",
  "version": "1.4.3",
  "private": true,
  "description": "Loopwright harness workspace (agentic workflow for opencode)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "oxlint && npm run fmt:check",
    "lint:fix": "oxlint --fix && npm run fmt",
    "fmt": "oxfmt --write \"harness/**/*.ts\" \"harness/**/*.tsx\" \"harness/*.json\" \"harness/.opencode/*.json\" \"*.config.ts\" \"*.json\" \".vscode/*.json\"",
    "fmt:check": "oxfmt --check \"harness/**/*.ts\" \"harness/**/*.tsx\" \"harness/*.json\" \"harness/.opencode/*.json\" \"*.config.ts\" \"*.json\" \".vscode/*.json\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.31",
    "@opentui/solid": "0.5.12",
    "@types/node": "^26.6.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "solid-js": "1.9.12",
    "typescript": "^7.0.2",
    "ultracite": "^7.12.0"
  }
}
