{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  // Models intentionally unset (2026-09-19): all agents inherit the runtime
  // default. Pin per-agent models here when the team standardizes on providers.
  // Permissions matrix is defined HERE (single source of truth); agent .md
  // files carry role prompts only and must not duplicate permission blocks.
  // Every known builtin is named on every agent (rule 48 / conventions): a
  // tool the matrix omits defaults to allow. MCP tools default deny (`mcp_*`)
  // until lpwr-setup evaluates a server and the human grants a phase slot.
  // Phase profile: Bootstrap→builder/scribe, Govern→scribe, Frame→planner/
  // scribe, Specify→scribe, Execute→builder, Verify→reviewer/scribe/builder
  // (release), Retain→builder/planner, Cross-cut→planner.
  "default_agent": "builder",
  "permission": {
    "doom_loop": "ask",
    "external_directory": "ask",
    "websearch": "deny",
    "mcp_*": "deny"
  },
  "agent": {
    "builder": {
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "ask",
        "task": "allow",
        "skill": "allow",
        "lsp": "allow",
        "question": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "ask",
        "doom_loop": "ask",
        "mcp_*": "deny"
