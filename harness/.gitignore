# Generated foundation — materialized by lpwr-install + lpwr-onboard;
# regenerate rather than commit. docs/memos is the shared memo dir: trunk-owned,
# symlinked into spec worktrees like state.md (rule 49 pattern).
docs/constitution.md
docs/context.md
docs/state.md
docs/audit.md
docs/memos

# Secrets — never commit (constitution security floors)
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Installed dependencies
node_modules/

# Loopwright installer state — manifest.json stays tracked; cache + backups do not
.loopwright/cache/
.loopwright/backups/

# Worktree lifecycle bookkeeping — the pending-cleanup manifest lpwr-commit
# writes (implementation-rules 52); trunk-owned, never part of a diff
.loop-worktrees/
