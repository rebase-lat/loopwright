{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "context": {
      "type": "local",
      "command": ["context", "serve"]
    },
    "graft": {
      "type": "local",
      "command": ["graft", "mcp"],
      "enabled": true
    },
    "engram": {
      "type": "local",
      "command": ["engram", "mcp"],
      "enabled": true
    }
  }
}
