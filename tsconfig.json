{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/solid",
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "harness/.opencode/plugins",
    "harness/.opencode/lib",
    "harness/.opencode/tui",
    "test",
    "oxlint.config.ts",
    "oxfmt.config.ts"
  ]
}
