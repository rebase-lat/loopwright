{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  // Models intentionally unset (2026-09-19): all agents inherit the runtime
  // default. Pin per-agent models here when the team standardizes on providers.
  // Permissions matrix is defined HERE (single source of truth); agent .md
  // files carry role prompts only and must not duplicate permission blocks.
  // Every known builtin is named on every agent (rule 48 / conventions): a
  // tool the matrix omits defaults to allow. MCP tools default deny (`mcp_*`)
  // until lpwr-setup evaluates a server and the human grants a phase slot.
  // Phase profile (2026-09-24, single-orchestrator): every command pins
  // agent: orchestrator — the only session the human interacts with.
  // Orchestrator delegates doer steps via Task (Frame→propose seats,
  // Specify/Bootstrap→scribe, Execute→builder, Verify→reviewer/scribe,
  // Release/Retain→builder, advise→planner) and aggregates their reports.
  // Builtins build/plan disabled so no other primary is interactable.
  // Orchestrator holds the only task: allow; every other agent, builder
  // included, carries task: deny — workers always return output (including
  // what they need); the orchestrator acknowledges, re-delegates, resumes
  // until completion; workers never delegate.
  "default_agent": "orchestrator",
  "permission": {
    "doom_loop": "ask",
    "external_directory": "ask",
    "websearch": "deny",
    "mcp_*": "deny"
  },
  "agent": {
    // Only interactive primary: builtin build/plan disabled — orchestrator
    // is the single agent the human interacts with (2026-09-24).
    "build": { "disable": true },
    "plan": { "disable": true },
    "orchestrator": {
      "permission": {
        "read": "allow",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "bash": "deny",
        "task": { "*": "allow", "general": "deny" },
        "skill": "allow",
        "lsp": "deny",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "deny",
        "external_directory": "ask",
        "doom_loop": "ask",
        "mcp_*": "deny"
      }
    },
    "builder": {
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "ask",
        "task": "deny",
        "skill": "allow",
        "lsp": "allow",
        "question": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "ask",
        "doom_loop": "ask",
        "mcp_*": "deny"
      }
    },
    "planner": {
      "permission": {
        "read": "allow",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "bash": "deny",
        "task": "deny",
        "skill": "allow",
        "lsp": "deny",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "deny",
        "external_directory": "ask",
        "doom_loop": "ask",
        "mcp_*": "deny"
      }
    },
    "neutral": {
